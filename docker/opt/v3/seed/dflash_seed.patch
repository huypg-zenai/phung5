diff --git a/python/sglang/srt/speculative/dflash_utils.py b/python/sglang/srt/speculative/dflash_utils.py
--- a/python/sglang/srt/speculative/dflash_utils.py
+++ b/python/sglang/srt/speculative/dflash_utils.py
@@ -822,6 +822,34 @@ def apply_dflash_simulated_acceptance(
     out_tokens[:, forced_accept_len].copy_(bonus.to(dtype=out_tokens.dtype))
 
 
+def dflash_seeded_verify_coins(
+    *,
+    sampling_info: Any,
+    seq_lens: torch.Tensor,
+    draft_token_num: int,
+    device,
+) -> Tuple[Optional[torch.Tensor], Optional[torch.Tensor]]:
+    """[dflash-seed] Per-request verify coins, same scheme as EAGLE.
+
+    Returns (coins [bs, draft_token_num], final_coins [bs]) derived from
+    murmur_hash32(sampling_seed, seq_lens, column) when sampling_seed is set
+    (EAGLE's _seeded_verify_coins), else (None, None) so the caller keeps the
+    stock torch.rand draws. Coins depend only on the request's own seed and
+    committed length, never on batch order or the global torch generator.
+    """
+    seed = getattr(sampling_info, "sampling_seed", None)
+    if seed is None:
+        return None, None
+    from sglang.srt.speculative.eagle_utils import _seeded_verify_coins
+
+    return _seeded_verify_coins(
+        sampling_seed=seed,
+        seq_lens=seq_lens,
+        draft_token_num=int(draft_token_num),
+        device=device,
+    )
+
+
 def compute_dflash_sampling_correct_drafts_and_bonus(
     *,
     candidates: torch.Tensor,
